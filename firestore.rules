rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// NOVIMED — Reglas de seguridad de Firestore (V41.1)
//
// PRINCIPIOS
//   1. Denegación por defecto. Nada fuera de schools/{schoolId} es accesible.
//   2. Aislamiento por institución: el schoolId del claim manda, no la ruta.
//   3. Ningún historial clínico se borra sin dejar constancia. Solo
//      SuperAdmin puede borrar (derecho de eliminación — LOPDP — a
//      solicitud de un padre o tutor). Nunca Admin_Colegio ni Personal_Salud.
//      Y no puede borrar sin que exista antes un registro en `erasureLog`
//      con el motivo: las reglas lo exigen, no es solo disciplina de
//      procedimiento (ver esa colección más abajo).
//   4. Ninguna escritura clínica sin autor verificado contra request.auth.uid.
//   5. El cliente no puede fechar en el futuro ni falsear al servidor.
//
// ROLES (claims del token): SuperAdmin · Admin_Colegio · Personal_Salud · Consulta
// Las sesiones anónimas solo existen dentro del tenant de ventas 'eight-demo'.
//
// ⚠️ ORDEN DE DESPLIEGUE OBLIGATORIO
//    Estas reglas deben publicarse ANTES de desplegar el código de V41.1.
//    Si el código llega primero, el archivado lógico y la autoría fallarán
//    contra las reglas antiguas. Si las reglas llegan primero, el código
//    antiguo sigue funcionando salvo el borrado en duro, que es exactamente
//    lo que queremos bloquear. Ver RUNBOOK §7.
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Identidad y pertenencia ─────────────────────────────────────────
    function signedIn()      { return request.auth != null; }
    function claims()        { return request.auth.token; }
    function role()          { return signedIn() && 'role' in claims() ? claims().role : 'Anonimo'; }
    function isAnonymous()   { return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    function isSuperAdmin()  { return role() == 'SuperAdmin'; }

    // El tenant demo es el ÚNICO lugar donde una sesión anónima tiene acceso.
    function belongsTo(schoolId) {
      return signedIn() && (
        isSuperAdmin() ||
        ('schoolId' in claims() && claims().schoolId == schoolId) ||
        (isAnonymous() && schoolId == 'eight-demo')
      );
    }

    // Consulta = solo lectura. El resto de roles reconocidos pueden escribir.
    function canWrite(schoolId) {
      return belongsTo(schoolId) &&
             (isAnonymous() || role() in ['SuperAdmin', 'Admin_Colegio', 'Personal_Salud']);
    }

    // ─── Autoría verificada ──────────────────────────────────────────────
    // El uid del documento debe ser el uid que ejecuta la escritura. Un
    // cliente no puede atribuir un acto clínico a otra persona.
    function authoredByCaller(data) {
      return 'createdBy' in data
          && data.createdBy is map
          && 'uid' in data.createdBy
          && data.createdBy.uid == request.auth.uid;
    }
    function updateAuthoredByCaller() {
      return 'updatedBy' in request.resource.data
          && request.resource.data.updatedBy is map
          && request.resource.data.updatedBy.uid == request.auth.uid;
    }

    // ─── Cronología honesta ──────────────────────────────────────────────
    // createdAt es el momento del HECHO CLÍNICO (reloj del cliente), no el de
    // la recepción: una atención registrada sin red se sincroniza horas
    // después y debe conservar su hora real. Por eso se permite el pasado sin
    // límite (registro en diferido) pero nunca el futuro más allá de una
    // tolerancia de desfase de reloj de 5 minutos.
    function sanePastTimestamp(data) {
      return 'createdAt' in data
          && data.createdAt is number
          && data.createdAt <= request.time.toMillis() + 300000;
    }

    // Solo cambian los campos listados: el resto del documento es inmutable.
    function onlyChanges(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // ─── Derecho de eliminación (LOPDP) ────────────────────────────────────
    // `erasureLog/{studentId}` — un documento por estudiante, con el
    // estudiante como ID del documento (no un id autogenerado). Es lo que
    // permite verificar "¿ya se registró el motivo para ESTE estudiante?"
    // con un exists() directo, sin necesitar una consulta. Solo SuperAdmin
    // puede crearlo, es create-only (nunca se actualiza ni se borra: es la
    // única prueba que sobrevive después de que el resto de los datos del
    // estudiante se hayan borrado), y solo entonces el borrado real de
    // students/careRecords/alerts/vaccines/inventoryLog para ese estudiante
    // queda permitido más abajo.
    function hasErasureLog(schoolId, studentId) {
      return studentId is string && studentId.size() > 0
          && exists(/databases/$(database)/documents/schools/$(schoolId)/erasureLog/$(studentId));
    }

    // ═══════════════════════════════════════════════════════════════════
    //  ÁRBOL MULTI-TENANT
    // ═══════════════════════════════════════════════════════════════════
    match /schools/{schoolId} {

      allow read:   if belongsTo(schoolId);
      allow write:  if false;   // el documento raíz del colegio se gestiona fuera de la app

      // ─── FICHAS DE ESTUDIANTES ─────────────────────────────────────────
      // La baja normal es el archivado lógico (motivo obligatorio y
      // autoría), no el borrado. El borrado real existe solo para el
      // derecho de eliminación (ver erasureLog más abajo): SuperAdmin,
      // y solo con el motivo ya registrado.
      match /students/{studentId} {
        allow read:   if belongsTo(schoolId);
        allow create: if canWrite(schoolId)
                      && authoredByCaller(request.resource.data)
                      && sanePastTimestamp(request.resource.data);

        // Dos formas legítimas de update:
        //  (a) archivado lógico, que exige motivo no vacío;
        //  (b) edición ordinaria de la ficha, que NO puede tocar el archivado.
        allow update: if canWrite(schoolId)
                      && updateAuthoredByCaller()
                      && (
                        // (a) archivar
                        (
                          request.resource.data.isArchived == true
                          && 'archivedReason' in request.resource.data
                          && request.resource.data.archivedReason is string
                          && request.resource.data.archivedReason.size() >= 3
                          && request.resource.data.archivedReason.size() <= 300
                          && 'archivedBy' in request.resource.data
                          && request.resource.data.archivedBy.uid == request.auth.uid
                          && onlyChanges(['isArchived','archivedReason','archivedAt','archivedBy','updatedAt','updatedBy'])
                        )
                        ||
                        // (b) editar la ficha sin alterar el estado de archivado
                        (
                          !onlyChanges(['isArchived','archivedReason','archivedAt','archivedBy','updatedAt','updatedBy'])
                          && request.resource.data.get('isArchived', false) == resource.data.get('isArchived', false)
                          && request.resource.data.createdBy == resource.data.createdBy
                        )
                        ||
                        // (c) backfill de claves foráneas (migración histórica)
                        (
                          isSuperAdmin()
                          && onlyChanges(['studentLinkStatus','studentLinkedAt','studentLinkedBy','updatedAt','updatedBy'])
                        )
                      );

        // 🔒 Solo SuperAdmin, y solo con el motivo ya registrado en
        // erasureLog para ESTE estudiante (derecho de eliminación, LOPDP).
        // Ningún otro rol puede borrar una ficha, nunca.
        allow delete: if isSuperAdmin() && hasErasureLog(schoolId, studentId);
      }

      // ─── ATENCIONES ────────────────────────────────────────────────────
      // Append-only. Lo único mutable es la confirmación familiar y el
      // enlace de clave foránea añadido por la migración.
      match /careRecords/{recordId} {
        allow read:   if belongsTo(schoolId);
        allow create: if canWrite(schoolId)
                      && authoredByCaller(request.resource.data)
                      && sanePastTimestamp(request.resource.data);
        allow update: if canWrite(schoolId)
                      && updateAuthoredByCaller()
                      && request.resource.data.createdBy == resource.data.createdBy
                      && request.resource.data.createdAt == resource.data.createdAt
                      && (
                        onlyChanges(['family','updatedAt','updatedBy'])
                        || (isSuperAdmin() && onlyChanges(['studentId','studentName','studentLinkStatus','studentLinkStatus','studentLinkedAt','studentLinkedBy','updatedAt','updatedBy']))
                      );
        // Solo SuperAdmin, y solo con erasureLog ya registrado para el
        // estudiante de ESTE registro (resource.data: el documento previo
        // al borrado). Sin studentId (registro huérfano nunca enlazado) no
        // hay forma de que exista el log correspondiente: queda protegido
        // por defecto, no expuesto por descuido.
        allow delete: if isSuperAdmin() && hasErasureLog(schoolId, resource.data.get('studentId', null));
      }

      // ─── ALERTAS ───────────────────────────────────────────────────────
      match /alerts/{alertId} {
        allow read:   if belongsTo(schoolId);
        allow create: if canWrite(schoolId)
                      && authoredByCaller(request.resource.data)
                      && sanePastTimestamp(request.resource.data)
                      && request.resource.data.status == 'pending';
        allow update: if canWrite(schoolId)
                      && request.resource.data.createdBy == resource.data.createdBy
                      && request.resource.data.createdAt == resource.data.createdAt
                      && (
                        onlyChanges([
                          'status','attendedAt','attendedTimeLabel','attendedBy',
                          'familyConfirmedAt','familyReadTimeLabel','familyConfirmedBy',
                          'careRecordId','updatedAt','updatedBy'
                        ])
                        || (isSuperAdmin() && onlyChanges(['studentId','studentName','studentLinkStatus','studentLinkStatus','studentLinkedAt','studentLinkedBy','updatedAt','updatedBy']))
                      );
        // Solo SuperAdmin, y solo con erasureLog ya registrado para el
        // estudiante de esta alerta.
        allow delete: if isSuperAdmin() && hasErasureLog(schoolId, resource.data.get('studentId', null));
      }

      // ─── INVENTARIO ────────────────────────────────────────────────────
      // El stock sí se corrige (es un conteo físico), pero cada movimiento
      // deja rastro inmutable en inventoryLog.
      match /inventory/{itemId} {
        allow read:   if belongsTo(schoolId);
        allow create: if canWrite(schoolId)
                      && authoredByCaller(request.resource.data)
                      && sanePastTimestamp(request.resource.data);
        // V42.0.1 — Este update no tenía onlyChanges() ni autoría verificada:
        // `stock` se podía reescribir a cualquier valor, en silencio y sin
        // dejar rastro en inventoryLog. El comentario de arriba afirma que
        // "cada movimiento deja rastro inmutable", y hasta ahora no era
        // cierto. Se acotan los campos y se valida que stock sea un número
        // no negativo.
        allow update: if canWrite(schoolId)
                      && updateAuthoredByCaller()
                      && request.resource.data.createdBy == resource.data.createdBy
                      && request.resource.data.stock is number
                      && request.resource.data.stock >= 0
                      && onlyChanges(['stock','min','name','category','expires','status','updatedAt','updatedBy']);
        allow delete: if false;
      }

      // ─── TRAZABILIDAD DE INSUMOS ───────────────────────────────────────
      // Entrega de medicación: sello de tiempo y responsable obligatorios,
      // y absolutamente inmutable salvo el enlace de la migración.
      match /inventoryLog/{logId} {
        allow read:   if belongsTo(schoolId);
        allow create: if canWrite(schoolId)
                      && authoredByCaller(request.resource.data)
                      && sanePastTimestamp(request.resource.data);
        allow update: if isSuperAdmin()
                      && onlyChanges(['studentId','studentName','studentLinkStatus','studentLinkStatus','studentLinkedAt','studentLinkedBy','updatedAt','updatedBy']);
        // Solo SuperAdmin, y solo con erasureLog ya registrado para el
        // estudiante de este movimiento.
        allow delete: if isSuperAdmin() && hasErasureLog(schoolId, resource.data.get('studentId', null));
      }

      // ─── VACUNAS ───────────────────────────────────────────────────────
      match /vaccines/{vaccineId} {
        allow read:   if belongsTo(schoolId);
        allow create: if canWrite(schoolId)
                      && authoredByCaller(request.resource.data)
                      && sanePastTimestamp(request.resource.data);
        allow update: if canWrite(schoolId)
                      && request.resource.data.createdBy == resource.data.createdBy;
        // Solo SuperAdmin, y solo con erasureLog ya registrado para el
        // estudiante de este registro de vacunación.
        allow delete: if isSuperAdmin() && hasErasureLog(schoolId, resource.data.get('studentId', null));
      }

      // ─── REGISTRO DE ELIMINACIÓN (derecho de eliminación · LOPDP) ───────
      // Un documento por estudiante, con studentId como ID del documento
      // (hasErasureLog() lo busca por ese path directamente). Create-only:
      // nunca se actualiza ni se borra, así que sigue existiendo como
      // prueba incluso después de que el resto de los datos del estudiante
      // se haya borrado. Solo SuperAdmin — ni Admin_Colegio ni
      // Personal_Salud pueden solicitar ni registrar una eliminación.
      match /erasureLog/{studentId} {
        allow read:   if isSuperAdmin();
        allow create: if isSuperAdmin()
                      && authoredByCaller(request.resource.data)
                      && sanePastTimestamp(request.resource.data)
                      && request.resource.data.studentId == studentId
                      && request.resource.data.reason is string
                      && request.resource.data.reason.size() >= 10
                      && request.resource.data.reason.size() <= 500;
        allow update, delete: if false;
      }

      // ─── METADATOS OPERATIVOS ──────────────────────────────────────────
      // Caso activo y banderas de siembra: coordinación efímera, no historia
      // clínica. Se permite sobrescritura, pero solo dentro del tenant.
      match /meta/{docId} {
        allow read:   if belongsTo(schoolId);
        allow write:  if canWrite(schoolId);
      }

      // Cualquier colección futura queda denegada hasta que se le escriba
      // una regla explícita. Añadir datos no debe abrir accesos por descuido.
      match /{document=**} {
        allow read, write: if false;
      }
    }
  }
}
