{
  "name": "novimed",
  "private": true,
  "version": "42.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:purge && npm run test:rules && npm run test:smoke",
    "test:purge": "node --test purge-test.mjs",
    "test:rules": "firebase emulators:exec --project demo-novimed \"node --test rules-test.mjs\"",
    "test:smoke": "firebase emulators:exec --project demo-novimed \"node smoke-test.mjs\"",
    "test:browsers": "playwright install chromium"
  },
  "dependencies": {
    "firebase": "^12.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase-admin": "^13.0.0",
    "firebase-tools": "^15.27.0",
    "playwright": "^1.62.1",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
